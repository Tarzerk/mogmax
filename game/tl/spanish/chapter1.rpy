# game/chapter1.rpy:99
translate spanish start_75164622:

    # narrator "Your name is [povname]."
    narrator "Te llamas [povname!t]."

# game/chapter1.rpy:100
translate spanish start_36b8c21f:

    # narrator "At least, that's what it says on the detention slip sitting on Mr. Harker's desk — again."
    narrator "Al menos eso dice el reporte de castigo sobre el escritorio del Sr. Harker... otra vez."

# game/chapter1.rpy:102
translate spanish start_7c9087c5:

    # narrator "It's a Tuesday. Or maybe Wednesday."
    narrator "Es martes. O tal vez miércoles."

# game/chapter1.rpy:103
translate spanish start_a9653900:

    # narrator "Honestly, you stopped keeping track somewhere around the third time you failed PE."
    narrator "La verdad, dejaste de llevar la cuenta como por la tercera vez que reprobaste Educación Física."

# game/chapter1.rpy:105
translate spanish start_c1785b3b:

    # narrator "You're sitting in the back of the cafeteria, alone, picking at a wet sandwich you found in your own backpack from last week."
    narrator "Estás al fondo de la cafetería, a solas, picoteando un sándwich húmedo que encontraste en tu propia mochila y que lleva ahí desde la semana pasada."

# game/chapter1.rpy:106
translate spanish start_7d816a59:

    # narrator "The expiration date is not something you want to think about."
    narrator "La fecha de caducidad no es algo en lo que quieras pensar."

# game/chapter1.rpy:113
translate spanish start_b54be11d:

    # narrator "It tastes like cardboard, but at least it crunches."
    narrator "Sabe a cartón, pero al menos cruje."

# game/chapter1.rpy:115
translate spanish start_a8dd2bee:

    # narrator "Cold moisture spreads across your tongue. You try very hard not to think about what it is."
    narrator "Una humedad fría se extiende por tu lengua. Te esfuerzas mucho por no pensar en qué es."

# game/chapter1.rpy:120
translate spanish start_3f56ea03:

    # narrator "Across the room, the popular kids are laughing."
    narrator "Al otro lado del salón, los populares se están riendo."

# game/chapter1.rpy:124
translate spanish start_fba353cc:

    # b "Eat up, LTN."
    b "Come, LTN."

# game/chapter1.rpy:125
translate spanish start_f21820e4:

    # narrator "Brayden doesn't even slow down. A single fry drops onto your tray as he passes — a coin tossed to a beggar."
    narrator "Brayden ni siquiera baja el paso. Deja caer una sola papa frita en tu bandeja al pasar: una moneda arrojada a un mendigo."

# game/chapter1.rpy:127
translate spanish start_ae64286f:

    # narrator "LTN. Low Tier Normie. Bottom of the barrel. Zero aura. The kind of person a room forgets while you're still in it."
    narrator "LTN. Low Tier Normie. Lo más bajo de lo bajo. Cero aura. El tipo de persona que un salón olvida incluso antes de que se vaya."

# game/chapter1.rpy:128
translate spanish start_eb02e528:

    # narrator "That's you. That's been you."
    narrator "Esa persona eres tú. Siempre lo has sido."

# game/chapter1.rpy:131
translate spanish start_5b894f4d:

    # narrator "You don't know what the joke is. You never do. You don't have to."
    narrator "No sabes cuál es el chiste. Nunca lo sabes. Tampoco hace falta."

# game/chapter1.rpy:132
translate spanish start_f396f914:

    # narrator "But somehow, you're pretty sure it's you."
    narrator "Pero, de algún modo, casi tienes la certeza de que eres tú."

# game/chapter1.rpy:136
translate spanish start_7e85ea90:

    # narrator "A tray slams on the table across from you."
    narrator "Una bandeja golpea la mesa frente a ti."

# game/chapter1.rpy:137
translate spanish start_ed03c546:

    # narrator "You flinch hard enough to knock your juice box onto the floor."
    narrator "Te sobresaltas tanto que tiras al suelo tu cajita de jugo."

# game/chapter1.rpy:142
translate spanish start_1680f1c9:

    # stranger "Relax."
    stranger "Relájate."

# game/chapter1.rpy:143
translate spanish start_0a7936b1:

    # narrator "The voice is calm. Too calm. You look up."
    narrator "La voz es tranquila. Demasiado tranquila. Levantas la mirada."

# game/chapter1.rpy:144
translate spanish start_856c7f8f:

    # narrator "A guy sits across from you like he owns the cafeteria."
    narrator "Un tipo se sienta frente a ti como si fuera dueño de la cafetería."

# game/chapter1.rpy:145
translate spanish start_9d28964d:

    # narrator "Sharp eyes, clean fit, the kind of posture that makes you suddenly aware of how bad yours is."
    narrator "Mirada afilada, outfit impecable, una postura que de pronto te hace notar lo mala que es la tuya."

# game/chapter1.rpy:146
translate spanish start_fec3afa0:

    # narrator "He looks at you the way a surgeon looks at a problem — like he already knows the solution."
    narrator "Te mira como un cirujano mira un problema: como si ya supiera la solución."

# game/chapter1.rpy:148
translate spanish start_7cbee3b1:

    # stranger "You're [povname], right?"
    stranger "Eres [povname!t], ¿verdad?"

# game/chapter1.rpy:149
translate spanish start_0f359a38:

    # narrator "Not a question, really."
    narrator "En realidad, no es una pregunta."

# game/chapter1.rpy:150
translate spanish start_c0cb9734:

    # p "...Yeah?"
    p "...¿Sí?"

# game/chapter1.rpy:151
translate spanish start_95aaad4d:

    # c "I'm Clav."
    c "Soy Clav."

# game/chapter1.rpy:153
translate spanish start_f1887944:

    # narrator "He leans forward."
    narrator "Se inclina hacia delante."

# game/chapter1.rpy:155
translate spanish start_5ad13133:

    # c "And I've been watching you for a while."
    c "Y llevo un tiempo observándote."

# game/chapter1.rpy:156
translate spanish start_5bc0d280:

    # p "That's... kind of creepy."
    p "Eso es... un poco perturbador."

# game/chapter1.rpy:157
translate spanish start_f9aed9af:

    # narrator "He smirks."
    narrator "Sonríe de lado."

# game/chapter1.rpy:158
translate spanish start_293a1288:

    # c "Maybe. But here's the thing, [povname] — I think you're wasting your life."
    c "Tal vez. Pero este es el asunto, [povname!t]: creo que estás desperdiciando tu vida."

# game/chapter1.rpy:160
translate spanish start_0a86f72f:

    # narrator "He pulls out two pills. One red, one blue."
    narrator "Saca dos pastillas. Una roja y una azul."

# game/chapter1.rpy:161
translate spanish start_0c012cfb:

    # narrator "Slides them across the table."
    narrator "Las desliza por la mesa."

# game/chapter1.rpy:163
translate spanish start_1be5a408:

    # c "So I'm giving you a choice."
    c "Así que te voy a dar una opción."

# game/chapter1.rpy:190
translate spanish chad_pill_ending_9bd3c2d9:

    # narrator "You reach out and take the red pill."
    narrator "Extiendes la mano y tomas la pastilla roja."

# game/chapter1.rpy:191
translate spanish chad_pill_ending_7711a6a6:

    # narrator "Clav nods slowly, like he already knew."
    narrator "Clav asiente despacio, como si ya lo supiera."

# game/chapter1.rpy:193
translate spanish chad_pill_ending_139c6bba:

    # c "Good."
    c "Bien."

# game/chapter1.rpy:194
translate spanish chad_pill_ending_b3dff6b7:

    # c "The work starts now."
    c "El trabajo empieza ahora."

# game/chapter1.rpy:195
translate spanish chad_pill_ending_2500a914:

    # c "And I mean that more literally than you think."
    c "Y lo digo de forma más literal de lo que crees."

# game/chapter1.rpy:198
translate spanish chad_pill_ending_84ef0207:

    # c "Library. After last bell."
    c "Biblioteca. Después de la última campana."

# game/chapter1.rpy:199
translate spanish chad_pill_ending_4ed44b23:

    # p "...why the library?"
    p "...¿por qué la biblioteca?"

# game/chapter1.rpy:200
translate spanish chad_pill_ending_8545cc17:

    # c "Tomorrow Harker springs a quiz nobody sees coming. You're going to pass it."
    c "Mañana Harker hará un examen sorpresa que nadie ve venir. Y tú lo vas a aprobar."

# game/chapter1.rpy:201
translate spanish chad_pill_ending_49a45dc1:

    # p "How would you even know that—"
    p "¿Y cómo podrías saber eso...?"

# game/chapter1.rpy:202
translate spanish chad_pill_ending_1694ec91:

    # c "Bring nothing but your brain."
    c "No lleves nada más que tu cerebro."

# game/chapter1.rpy:204
translate spanish chad_pill_ending_e32ec6de:

    # narrator "He never answers the question. He just lets it hang there — like he already knows you'll show up anyway."
    narrator "Nunca responde la pregunta. Solo la deja en el aire, como si ya supiera que vas a presentarte de todos modos."

# game/chapter1.rpy:218
translate spanish ltn_pill_ending_c0ee98fe:

    # narrator "You reach for the blue pill."
    narrator "Extiendes la mano hacia la pastilla azul."

# game/chapter1.rpy:219
translate spanish ltn_pill_ending_08e906d9:

    # narrator "You swallow it before you can think about it."
    narrator "Te la tragas antes de poder pensarlo."

# game/chapter1.rpy:222
translate spanish ltn_pill_ending_daaab1aa:

    # c "...blue."
    c "...azul."

# game/chapter1.rpy:223
translate spanish ltn_pill_ending_4e8c7062:

    # c "Of course."
    c "Por supuesto."

# game/chapter1.rpy:225
translate spanish ltn_pill_ending_ebeac70f:

    # c "Enjoy the sandwich."
    c "Disfruta el sándwich."

# game/chapter1.rpy:228
translate spanish ltn_pill_ending_7b8bfc3f:

    # narrator "Clav stands and walks away. No speech. No goodbye. Just footsteps fading into the cafeteria noise."
    narrator "Clav se levanta y se va. Sin discurso. Sin despedida. Solo sus pasos perdiéndose entre el ruido de la cafetería."

# game/chapter1.rpy:243
translate spanish ltn_pill_ending_327a7732:

    # stranger "So. How was he?"
    stranger "Y bien. ¿Cómo le fue?"

# game/chapter1.rpy:245
translate spanish ltn_pill_ending_1914d34c:

    # c "...Blue pill."
    c "...Pastilla azul."

# game/chapter1.rpy:247
translate spanish ltn_pill_ending_2cc931fb:

    # stranger "Hm."
    stranger "Mmm."

# game/chapter1.rpy:251
translate spanish ltn_pill_ending_0fadfa96:

    # narrator "Beyond the glass, a figure sits at a massive desk facing the city. He sets the report down on a stack of identical files. He does not turn around."
    narrator "Tras el vidrio, una figura está sentada ante un escritorio enorme de cara a la ciudad. Deja el reporte sobre una pila de expedientes idénticos. No se da la vuelta."

# game/chapter1.rpy:253
translate spanish ltn_pill_ending_018d4050:

    # stranger "How shameful."
    stranger "Qué vergüenza."

