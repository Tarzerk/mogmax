

# game/chapter2.rpy:87
translate spanish chapter2_pickup_4226829a:

    # narrator "Black. Dead asleep. The kind of sleep that doesn't ask questions."
    narrator "Negro. Sueño profundo. De ese que no hace preguntas."

# game/chapter2.rpy:90
translate spanish chapter2_pickup_7ab35a0f:

    # narrator "{b}HONK HONK.{/b}"
    narrator "{b}PIP PIP.{/b}"

# game/chapter2.rpy:91
translate spanish chapter2_pickup_5f94375d:

    # narrator "A car horn blares outside your window. You jolt awake."
    narrator "El claxon de un auto retumba afuera de tu ventana. Despiertas de golpe."

# game/chapter2.rpy:92
translate spanish chapter2_pickup_6ed170b5:

    # c "Get up. We're leaving."
    c "Levántate. Nos vamos."

# game/chapter2.rpy:93
translate spanish chapter2_pickup_53383c32:

    # p "...where exactly?"
    p "...¿a dónde exactamente?"

# game/chapter2.rpy:94
translate spanish chapter2_pickup_ba8cfef2:

    # c "I said let's go."
    c "Dije que nos vamos."

# game/chapter2.rpy:95
translate spanish chapter2_pickup_65b4ef71:

    # narrator "No further explanation. The car is already running."
    narrator "No da más explicaciones. El auto ya está encendido."

# game/chapter2.rpy:102
translate spanish chapter2_road_0e144c31:

    # narrator "At first there are streetlights. Then fewer streetlights. Then the road becomes one long dark line under the headlights."
    narrator "Al principio hay postes de luz. Luego, menos postes de luz. Después, la carretera se convierte en una larga línea oscura bajo los faros."

# game/chapter2.rpy:107
translate spanish chapter2_road_9ca2459c:

    # p "Where are we going?"
    p "¿A dónde vamos?"

# game/chapter2.rpy:108
translate spanish chapter2_road_23534fe1:

    # c "West."
    c "Al oeste."

# game/chapter2.rpy:109
translate spanish chapter2_road_af4e2235:

    # p "That is not an answer."
    p "Eso no es una respuesta."

# game/chapter2.rpy:110
translate spanish chapter2_road_ad30b96b:

    # c "It's a direction."
    c "Es una dirección."

# game/chapter2.rpy:112
translate spanish chapter2_road_d0a3513f:

    # p "Is this legal?"
    p "¿Esto es legal?"

# game/chapter2.rpy:113
translate spanish chapter2_road_54b9789b:

    # c "Most important things aren't."
    c "La mayoría de las cosas importantes no lo son."

# game/chapter2.rpy:114
translate spanish chapter2_road_7b5a6284:

    # p "That made me feel worse."
    p "Eso me hizo sentir peor."

# game/chapter2.rpy:115
translate spanish chapter2_road_4419dde8:

    # c "Good. You're listening."
    c "Bien. Estás prestando atención."

# game/chapter2.rpy:117
translate spanish chapter2_road_81dc03b0:

    # narrator "You sit in silence."
    narrator "Te quedas en silencio."

# game/chapter2.rpy:119
translate spanish chapter2_road_e01ce2b2:

    # p "...Are we there yet?"
    p "...¿Ya llegamos?"

# game/chapter2.rpy:120
translate spanish chapter2_road_e69e42b8:

    # c "No."
    c "No."

# game/chapter2.rpy:122
translate spanish chapter2_road_c032712b:

    # narrator "Ten minutes becomes forty. Houses turn into gas stations. Gas stations turn into nothing."
    narrator "Diez minutos se convierten en cuarenta. Las casas se vuelven gasolineras. Las gasolineras se vuelven nada."

# game/chapter2.rpy:123
translate spanish chapter2_road_1da8f6fc:

    # p "Clav, I literally have school tomorrow."
    p "Clav, literalmente tengo clases mañana."

# game/chapter2.rpy:124
translate spanish chapter2_road_73078d8c:

    # c "You had school yesterday. Look what it did for you."
    c "Ayer también tuviste clases. Mira lo que hicieron por ti."

# game/chapter2.rpy:125
translate spanish chapter2_road_717f2fc2:

    # p "Honestly... valid."
    p "La verdad... válido."

# game/chapter2.rpy:142
translate spanish chapter2_restricted_sign_63f8b27a:

    # p "[[yawn] where are we?"
    p "[[bostezo] ¿dónde estamos?"

# game/chapter2.rpy:143
translate spanish chapter2_restricted_sign_937f627f:

    # narrator "The car stops. The camera pans to a sign staked in the dirt."
    narrator "El auto se detiene. La cámara enfoca un letrero clavado en la tierra."

# game/chapter2.rpy:144
translate spanish chapter2_restricted_sign_f89b4fdc:

    # narrator "{b}⚠ RESTRICTED AREA — USE OF DEADLY FORCE AUTHORIZED ⚠{/b}"
    narrator "{b}⚠ ÁREA RESTRINGIDA — AUTORIZADO EL USO DE FUERZA LETAL ⚠{/b}"

# game/chapter2.rpy:145
translate spanish chapter2_restricted_sign_3f5b31eb:

    # p "Yoo... I think we aren't supposed to be here...."
    p "Yoo... creo que no deberíamos estar aquí..."

# game/chapter2.rpy:146
translate spanish chapter2_restricted_sign_00e8850a:

    # narrator "Clav smirks. Says nothing."
    narrator "Clav sonríe de lado. No dice nada."

# game/chapter2.rpy:150
translate spanish chapter2_gate_d2779580:

    # narrator "The car rolls up to the gate. A chain-link fence. A STOP sign. Two soldiers."
    narrator "El auto avanza hasta la entrada. Una cerca de malla. Una señal de ALTO. Dos soldados."

# game/chapter2.rpy:152
translate spanish chapter2_gate_de632a98:

    # sol "Turn around. Now."
    sol "Den la vuelta. Ahora."

# game/chapter2.rpy:153
translate spanish chapter2_gate_79fc67a7:

    # p "Clav. We CANNOT be here."
    p "Clav. NO PODEMOS estar aquí."

# game/chapter2.rpy:154
translate spanish chapter2_gate_352812ae:

    # narrator "A shadow falls over the soldiers. A Captain steps forward."
    narrator "Una sombra cae sobre los soldados. Un capitán da un paso al frente."

# game/chapter2.rpy:156
translate spanish chapter2_gate_0f836f51:

    # cap "OPEN IT UP."
    cap "ÁBRANLA."

# game/chapter2.rpy:157
translate spanish chapter2_gate_6d2e6448:

    # sol "...Yes sir."
    sol "...Sí, señor."

# game/chapter2.rpy:160
translate spanish chapter2_gate_f618ad8b:

    # narrator "The gate grinds open."
    narrator "La entrada se abre con un chirrido."

# game/chapter2.rpy:171
translate spanish chapter2_base_8c93f992:

    # narrator "Layer after layer of security. Retinal scans. Badge checks. Armed guards."
    narrator "Capa tras capa de seguridad. Escáneres de retina. Controles de credenciales. Guardias armados."

# game/chapter2.rpy:172
translate spanish chapter2_base_281ce946:

    # narrator "And yet — nobody stops you. Nobody even looks twice."
    narrator "Y aun así, nadie te detiene. Nadie mira dos veces."

# game/chapter2.rpy:173
translate spanish chapter2_base_69ea3d3d:

    # narrator "It's like you were expected."
    narrator "Es como si te estuvieran esperando."

# game/chapter2.rpy:174
translate spanish chapter2_base_172875bf:

    # p "I can't believe I'm actually here."
    p "No puedo creer que de verdad esté aquí."

# game/chapter2.rpy:175
translate spanish chapter2_base_fdc26711:

    # p "...Are aliens real?"
    p "...¿Los extraterrestres existen?"

# game/chapter2.rpy:177
translate spanish chapter2_base_9fb73739:

    # c "You have a lot to learn, normie."
    c "Te falta mucho por aprender, normie."

# game/chapter2.rpy:180
translate spanish chapter2_base_9b91ff54:

    # narrator "You reach a massive vault door. Clav steps forward. A scanner activates. Blue light sweeps slowly across his jaw."
    narrator "Llegan a una enorme puerta de bóveda. Clav da un paso al frente. Un escáner se activa. Una luz azul recorre lentamente su mandíbula."

# game/chapter2.rpy:198
translate spanish chapter2_lab_reveal_feed5cba:

    # c "Most people think Area 51 is about aliens. Advanced weapons. Classified tech."
    c "La mayoría cree que el Área 51 se trata de extraterrestres. Armas avanzadas. Tecnología clasificada."

# game/chapter2.rpy:199
translate spanish chapter2_lab_reveal_e940eac4:

    # c "That's exactly what we want them to think."
    c "Eso es exactamente lo que queremos que crean."

# game/chapter2.rpy:200
translate spanish chapter2_lab_reveal_4e79ad85:

    # c "The real research has been going on for 60 years."
    c "La verdadera investigación lleva 60 años en marcha."

# game/chapter2.rpy:201
translate spanish chapter2_lab_reveal_9201ced1:

    # p "...What research?"
    p "...¿Qué investigación?"

# game/chapter2.rpy:202
translate spanish chapter2_lab_reveal_aff9448a:

    # c "Frame. Brain. Aura. The US government cracked gigamaxxing before the internet even existed."
    c "Frame. Cerebro. Aura. El gobierno de EE. UU. descifró el gigamaxxing antes de que existiera internet."

# game/chapter2.rpy:205
translate spanish chapter2_lab_reveal_a1ee9790:

    # narrator "The room opens up. Whiteboards covered in mewing diagrams. Posture charts. Vocabulary trees. A framed photo of a jaw — classified EYES ONLY."
    narrator "La sala se abre ante ti. Pizarras cubiertas de diagramas de mewing. Gráficas de postura. Árboles de vocabulario. Una foto enmarcada de una mandíbula, clasificada SOLO PARA SUS OJOS."

# game/chapter2.rpy:207
translate spanish chapter2_lab_reveal_e7299e3d:

    # c "[povname]. With great power comes great responsibility."
    c "[povname!t]. Un gran poder conlleva una gran responsabilidad."

# game/chapter2.rpy:208
translate spanish chapter2_lab_reveal_4889128d:

    # c "Trust the process."
    c "Confía en el proceso."

# game/chapter2.rpy:215
translate spanish chapter2_gigachad_hall_7cc57021:

    # narrator "The lab narrows into a service hall. Glass cabinets on one side. Pipes and sealed doors on the other."
    narrator "El laboratorio se estrecha hasta convertirse en un pasillo de servicio. Vitrinas de un lado. Tuberías y puertas selladas del otro."

# game/chapter2.rpy:221
translate spanish chapter2_gigachad_hall_e4af1ba3:

    # narrator "A man in a lab coat stands at the far end with his back to you. Even from here, his frame nearly fills the doorway."
    narrator "Un hombre con bata de laboratorio está al fondo, de espaldas. Incluso desde aquí, su frame casi llena la entrada."

# game/chapter2.rpy:222
translate spanish chapter2_gigachad_hall_a3f39eb5:

    # narrator "He doesn't move. Still, you get the strange feeling you've interrupted something."
    narrator "No se mueve. Aun así, tienes la extraña sensación de haber interrumpido algo."

# game/chapter2.rpy:223
translate spanish chapter2_gigachad_hall_faf23ec4:

    # p "Clav... who is that?"
    p "Clav... ¿quién es?"

# game/chapter2.rpy:224
translate spanish chapter2_gigachad_hall_5e39fec1:

    # c "Keep walking."
    c "Sigue caminando."

# game/chapter2.rpy:225
translate spanish chapter2_gigachad_hall_77690d68:

    # p "You know him?"
    p "¿Lo conoces?"

# game/chapter2.rpy:226
translate spanish chapter2_gigachad_hall_fc650eb3:

    # c "Everyone here knows him."
    c "Aquí todo el mundo lo conoce."

# game/chapter2.rpy:227
translate spanish chapter2_gigachad_hall_272dde0d:

    # narrator "The unmarked door in front of him unlocks. He steps through without looking back."
    narrator "La puerta sin identificar frente a él se desbloquea. Entra sin mirar atrás."

# game/chapter2.rpy:229
translate spanish chapter2_gigachad_hall_77edd28e:

    # narrator "The door seals behind him."
    narrator "La puerta se sella detrás de él."

# game/chapter2.rpy:230
translate spanish chapter2_gigachad_hall_b30204a5:

    # narrator "The hall feels bigger after he's gone. Not emptier. Bigger."
    narrator "El pasillo se siente más grande después de que se va. No más vacío. Más grande."

# game/chapter2.rpy:231
translate spanish chapter2_gigachad_hall_4e548dcb:

    # p "That didn't answer me."
    p "Eso no respondió mi pregunta."

# game/chapter2.rpy:233
translate spanish chapter2_gigachad_hall_08126669:

    # c "Gigachad."
    c "Gigachad."

# game/chapter2.rpy:234
translate spanish chapter2_gigachad_hall_669bb509:

    # p "That's his name?"
    p "¿Ese es su nombre?"

# game/chapter2.rpy:235
translate spanish chapter2_gigachad_hall_3b38a4e8:

    # c "It's his classification."
    c "Es su clasificación."

# game/chapter2.rpy:236
translate spanish chapter2_gigachad_hall_b9fd5675:

    # p "For what?"
    p "¿De qué?"

# game/chapter2.rpy:238
translate spanish chapter2_gigachad_hall_5e39fec1_1:

    # c "Keep walking."
    c "Sigue caminando."

# game/chapter2.rpy:259
translate spanish chapter2_projection_gallery_917467d4:

    # narrator "The next door opens onto a windowless room and one enormous blank wall."
    narrator "La siguiente puerta da a una sala sin ventanas con una enorme pared vacía."

# game/chapter2.rpy:260
translate spanish chapter2_projection_gallery_79a7af10:

    # narrator "An old projector chatters behind you. Grain crawls across the concrete."
    narrator "Un viejo proyector traquetea a tu espalda. El grano se arrastra por el concreto."

# game/chapter2.rpy:270
translate spanish chapter2_projection_gallery_b707e6af:

    # narrator "One by one, figures enter the light."
    narrator "Una a una, varias figuras entran en la luz."

# game/chapter2.rpy:271
translate spanish chapter2_projection_gallery_97aa49d3:

    # narrator "No names. No plaques. Just bodies reduced to movement, posture, and presence."
    narrator "Sin nombres. Sin placas. Solo cuerpos reducidos a movimiento, postura y presencia."

# game/chapter2.rpy:272
translate spanish chapter2_projection_gallery_8598a63e:

    # narrator "A footballer caught mid-cut. A skater hanging calmly in the air. Shapes you almost recognize, sliding past one after another."
    narrator "Un futbolista capturado a mitad de un cambio de dirección. Un patinador suspendido tranquilamente en el aire. Siluetas que casi reconoces pasan una tras otra."

# game/chapter2.rpy:273
translate spanish chapter2_projection_gallery_507fba30:

    # narrator "Different bodies. Different worlds. Same impossible feeling — like gravity has quietly agreed to help them."
    narrator "Cuerpos distintos. Mundos distintos. La misma sensación imposible: como si la gravedad hubiera aceptado ayudarlos en silencio."

# game/chapter2.rpy:274
translate spanish chapter2_projection_gallery_96e24264:

    # p "Are these... famous people?"
    p "¿Son... personas famosas?"

# game/chapter2.rpy:275
translate spanish chapter2_projection_gallery_9a2ab98d:

    # c "No names in the facility."
    c "En las instalaciones no hay nombres."

# game/chapter2.rpy:276
translate spanish chapter2_projection_gallery_db1f5e1a:

    # p "Why?"
    p "¿Por qué?"

# game/chapter2.rpy:277
translate spanish chapter2_projection_gallery_d3b0deb3:

    # c "Names make people think this is celebrity."
    c "Los nombres hacen que la gente crea que esto se trata de fama."

# game/chapter2.rpy:278
translate spanish chapter2_projection_gallery_e539e083:

    # c "It isn't."
    c "No es así."

# game/chapter2.rpy:279
translate spanish chapter2_projection_gallery_f431e9fc:

    # c "It's gravity."
    c "Se trata de gravedad."

# game/chapter2.rpy:280
translate spanish chapter2_projection_gallery_a512ccd1:

    # narrator "You look again. Not posters. Specimens."
    narrator "Miras de nuevo. No son pósteres. Son especímenes."

# game/chapter2.rpy:281
translate spanish chapter2_projection_gallery_5ad3099e:

    # c "Some people mog without trying. Without knowing. Without caring."
    c "Algunas personas moguean sin intentarlo. Sin saberlo. Sin que les importe."

# game/chapter2.rpy:282
translate spanish chapter2_projection_gallery_ac3c68ae:

    # c "They walk into the world already carrying something everyone else has to build."
    c "Llegan al mundo cargando algo que todos los demás tienen que construir."

# game/chapter2.rpy:283
translate spanish chapter2_projection_gallery_1236c43f:

    # p "So what, they're the goal?"
    p "Entonces, ¿son la meta?"

# game/chapter2.rpy:284
translate spanish chapter2_projection_gallery_e69e42b8:

    # c "No."
    c "No."

# game/chapter2.rpy:285
translate spanish chapter2_projection_gallery_7f741795:

    # c "They're proof."
    c "Son la prueba."

# game/chapter2.rpy:286
translate spanish chapter2_projection_gallery_8ea4bd14:

    # c "Brain gets you through a test. Controlled conditions. Paper. Definitions."
    c "El cerebro te ayuda a superar un examen. Condiciones controladas. Papel. Definiciones."

# game/chapter2.rpy:287
translate spanish chapter2_projection_gallery_9305d67d:

    # c "But Brayden isn't a worksheet."
    c "Pero Brayden no es una hoja de ejercicios."

# game/chapter2.rpy:288
translate spanish chapter2_projection_gallery_2dfb4c9c:

    # c "He doesn't beat people by being smarter. He beats them by making the room agree with him before anyone speaks."
    c "No vence a la gente por ser más inteligente. La vence haciendo que toda la sala esté de acuerdo con él antes de que alguien hable."

# game/chapter2.rpy:289
translate spanish chapter2_projection_gallery_6494e6e2:

    # c "That's Frame. That's Aura."
    c "Eso es Frame. Eso es Aura."

# game/chapter2.rpy:290
translate spanish chapter2_projection_gallery_70a6e49c:

    # p "And Gigachad?"
    p "¿Y Gigachad?"

# game/chapter2.rpy:301
translate spanish chapter2_projection_gallery_b65984f3:

    # c "Those people mog in one direction. Movement. Body. Presence. Myth."
    c "Esas personas moguean en una sola dirección. Movimiento. Cuerpo. Presencia. Mito."

# game/chapter2.rpy:303
translate spanish chapter2_projection_gallery_08adb917:

    # c "Gigachad is what happens when nothing is missing."
    c "Gigachad es lo que pasa cuando no falta nada."

# game/chapter2.rpy:305
translate spanish chapter2_projection_gallery_6d8e5d6c:

    # c "You won't reach that."
    c "Tú no llegarás a eso."

# game/chapter2.rpy:306
translate spanish chapter2_projection_gallery_6f9c1035:

    # p "...Oh."
    p "...Ah."

# game/chapter2.rpy:307
translate spanish chapter2_projection_gallery_7c9cbfd3:

    # c "Neither did I."
    c "Yo tampoco llegué."

# game/chapter2.rpy:308
translate spanish chapter2_projection_gallery_4a6a4c71:

    # narrator "He says it too fast. Like the sentence bit him on the way out."
    narrator "Lo dice demasiado rápido. Como si la frase lo hubiera mordido al salir."

# game/chapter2.rpy:311
translate spanish chapter2_projection_gallery_ef3ced3c:

    # c "But you don't need the ceiling."
    c "Pero no necesitas llegar al límite."

# game/chapter2.rpy:312
translate spanish chapter2_projection_gallery_c78374fd:

    # c "You need one step."
    c "Necesitas un paso."

# game/chapter2.rpy:313
translate spanish chapter2_projection_gallery_a8ce0f32:

    # c "One step is the difference between a room forgetting you and a room checking where you're standing."
    c "Un paso es la diferencia entre una sala que te olvida y una que revisa dónde estás."

# game/chapter2.rpy:314
translate spanish chapter2_projection_gallery_4d7354f0:

    # c "So."
    c "Así que."

# game/chapter2.rpy:315
translate spanish chapter2_projection_gallery_8d5af514:

    # c "Training wing."
    c "Ala de entrenamiento."

# game/chapter2.rpy:327
translate spanish chapter2_training_96f0a7a4:

    # narrator "The training wing. Different people run each station. Nobody introduces themselves. Nobody has to."
    narrator "El ala de entrenamiento. Personas distintas dirigen cada estación. Nadie se presenta. Nadie tiene que hacerlo."

# game/chapter2.rpy:330
translate spanish chapter2_training_2ca82478:

    # c "Everything so far was observation. Brain. Frame. Aura. The scan at the door."
    c "Hasta ahora, todo fue observación. Cerebro. Frame. Aura. El escaneo de la puerta."

# game/chapter2.rpy:331
translate spanish chapter2_training_50538e88:

    # c "First you build the pieces. Then you learn what they do to someone."
    c "Primero construyes las piezas. Luego aprendes lo que pueden hacerle a alguien."

# game/chapter2.rpy:335
translate spanish chapter2_training_4e6c601f:

    # narrator "They run you through all of it. Hours of it."
    narrator "Te hacen pasar por todo. Horas y horas."

# game/chapter2.rpy:337
translate spanish chapter2_training_21c7e3c7:

    # narrator "The first station is a steel chair facing an anatomy terminal. Two skulls stare back at you. One weak. One classified."
    narrator "La primera estación es una silla de acero frente a una terminal de anatomía. Dos cráneos te devuelven la mirada. Uno débil. Uno clasificado."

# game/chapter2.rpy:339
translate spanish chapter2_training_87521e38:

    # c "Mewing Geometry. Four positions. Miss the window and the machine rejects your palate."
    c "Geometría de mewing. Cuatro posiciones. Si fallas la ventana, la máquina rechaza tu paladar."

# game/chapter2.rpy:340
translate spanish chapter2_training_dfe135ad:

    # p "The machine can reject my palate?"
    p "¿La máquina puede rechazar mi paladar?"

# game/chapter2.rpy:341
translate spanish chapter2_training_87df035b:

    # c "It can do worse."
    c "Puede hacer cosas peores."

# game/chapter2.rpy:347
translate spanish chapter2_training_69b08db2:

    # narrator "The terminal flashes green on the first sequence. Somewhere behind the glass, a technician slowly removes his sunglasses."
    narrator "La terminal parpadea en verde en la primera secuencia. Detrás del vidrio, un técnico se quita lentamente los lentes de sol."

# game/chapter2.rpy:349
translate spanish chapter2_training_a6a82678:

    # c "Beginner's luck. Extremely classified beginner's luck."
    c "Suerte de principiante. Suerte de principiante extremadamente clasificada."

# game/chapter2.rpy:352
translate spanish chapter2_training_5c456db4:

    # narrator "The terminal makes you reset, then accepts the lock with a deep mechanical thunk."
    narrator "La terminal te obliga a reiniciar y luego acepta el bloqueo con un golpe mecánico grave."

# game/chapter2.rpy:354
translate spanish chapter2_training_16908ef1:

    # c "Messy. But your palate has clearance."
    c "Nada limpio. Pero tu paladar tiene autorización."

# game/chapter2.rpy:357
translate spanish chapter2_training_86e8c894:

    # narrator "By the time the terminal finally turns green, your tongue feels like it has completed basic training."
    narrator "Para cuando la terminal finalmente se pone verde, tu lengua siente que terminó el entrenamiento básico."

# game/chapter2.rpy:359
translate spanish chapter2_training_81ee93ff:

    # c "Nobody saw the first attempts. The cameras are classified."
    c "Nadie vio los primeros intentos. Las cámaras son información clasificada."

# game/chapter2.rpy:362
translate spanish chapter2_training_40c902f2:

    # narrator "A curtain jerks open at the next station. Behind it sits an arcade cabinet bolted to the floor, connected to a giant mechanical jaw on a rail."
    narrator "Una cortina se abre de golpe en la siguiente estación. Detrás hay una máquina arcade atornillada al piso, conectada a una mandíbula mecánica gigante sobre un riel."

# game/chapter2.rpy:364
translate spanish chapter2_training_20ad2306:

    # c "Aura Harvester 6000."
    c "Aura Harvester 6000."

# game/chapter2.rpy:365
translate spanish chapter2_training_a3e4dba5:

    # p "Why does it have teeth?"
    p "¿Por qué tiene dientes?"

# game/chapter2.rpy:366
translate spanish chapter2_training_d58982d6:

    # c "Improves retention."
    c "Mejora la retención."

# game/chapter2.rpy:367
translate spanish chapter2_training_ad31f087:

    # c "Green outline adds aura. Red outline drains whatever you've built. Catch enough to reach one hundred."
    c "El contorno verde suma aura. El rojo drena lo que hayas acumulado. Atrapa suficientes para llegar a cien."

# game/chapter2.rpy:368
translate spanish chapter2_training_0bbd3fd3:

    # p "So I can't run out of lives?"
    p "Entonces, ¿no se me pueden acabar las vidas?"

# game/chapter2.rpy:369
translate spanish chapter2_training_a8f668bd:

    # c "No. You can only watch the number go back down."
    c "No. Solo puedes ver cómo el número vuelve a bajar."

# game/chapter2.rpy:370
translate spanish chapter2_training_b625800c:

    # p "That feels worse."
    p "Eso se siente peor."

# game/chapter2.rpy:371
translate spanish chapter2_training_5aa79f8f:

    # c "Correct."
    c "Correcto."

# game/chapter2.rpy:378
translate spanish chapter2_training_0b3d506b:

    # narrator "The jaw slams shut hard enough to shake the cabinet. Green lights race across the machine: {color=#69ff9a}AURA STABILIZED.{/color}"
    narrator "La mandíbula se cierra con tanta fuerza que sacude la máquina. Luces verdes recorren el gabinete: {color=#69ff9a}AURA ESTABILIZADA.{/color}"

# game/chapter2.rpy:380
translate spanish chapter2_training_e40fd4fa:

    # c "One hundred. The federal minimum for entering a room like you belong there."
    c "Cien. El mínimo federal para entrar a una sala como si pertenecieras ahí."

# game/chapter2.rpy:381
translate spanish chapter2_training_ef8925ab:

    # p "That cannot be a real measurement."
    p "Esa no puede ser una medida real."

# game/chapter2.rpy:382
translate spanish chapter2_training_9b016399:

    # c "It has a number. Of course it's real."
    c "Tiene un número. Claro que es real."

# game/chapter2.rpy:385
translate spanish chapter2_training_78caca36:

    # narrator "At the next station, a scanner lowers over a blank anatomical face. It has no eyes. Somehow it still looks judgmental."
    narrator "En la siguiente estación, un escáner desciende sobre un rostro anatómico en blanco. No tiene ojos. De algún modo, aun así parece estar juzgándote."

# game/chapter2.rpy:387
translate spanish chapter2_training_adad4681:

    # c "Dermal Purge. Clear active inflammation. Leave permanent marks alone."
    c "Purga dérmica. Elimina la inflamación activa. Deja en paz las marcas permanentes."

# game/chapter2.rpy:388
translate spanish chapter2_training_af4ef4b6:

    # p "And if I click a mole?"
    p "¿Y si hago clic en un lunar?"

# game/chapter2.rpy:389
translate spanish chapter2_training_86b38f5e:

    # c "The machine documents your lack of restraint."
    c "La máquina documenta tu falta de autocontrol."

# game/chapter2.rpy:397
translate spanish chapter2_training_montage_cd7d3c4e:

    # narrator "The scan turns green: {color=#69e4ad}CLEAR SKIN. +100 AURA.{/color}"
    narrator "El escáner se pone verde: {color=#69e4ad}PIEL LIMPIA. +100 AURA.{/color}"

# game/chapter2.rpy:400
translate spanish chapter2_training_montage_99c285b5:

    # c "No collateral damage. Unexpectedly civilized."
    c "Sin daños colaterales. Una civilidad inesperada."

# game/chapter2.rpy:404
translate spanish chapter2_training_montage_98dd7782:

    # c "You attacked [acne_mistakes] permanent features. We'll call that enthusiasm."
    c "Atacaste [acne_mistakes] rasgos permanentes. Lo llamaremos entusiasmo."

# game/chapter2.rpy:409
translate spanish chapter2_training_montage_7d701280:

    # narrator "After that, the stations stop feeling separate. The next hour comes back in flashes."
    narrator "Después de eso, las estaciones dejan de sentirse separadas. La siguiente hora regresa en destellos."

# game/chapter2.rpy:410
translate spanish chapter2_training_montage_c3d65fcd:

    # narrator "A posture harness yanks your shoulders into alignment every time you slouch. By the sixth correction, you start catching yourself before the machine does."
    narrator "Un arnés de postura te jala los hombros hasta alinearlos cada vez que te encorvas. Para la sexta corrección, empiezas a corregirte antes que la máquina."

# game/chapter2.rpy:412
translate spanish chapter2_training_montage_1d9bb339:

    # c "Frame begins before anyone sees your face. Again."
    c "El Frame empieza antes de que alguien vea tu cara. Otra vez."

# game/chapter2.rpy:414
translate spanish chapter2_training_montage_a35650a4:

    # narrator "A height rig calibrates your stance down to the millimeter. Chin level. Weight balanced. Heels planted like the floor owes you stability."
    narrator "Un aparato de altura calibra tu postura al milímetro. Barbilla nivelada. Peso equilibrado. Talones firmes, como si el piso te debiera estabilidad."

# game/chapter2.rpy:415
translate spanish chapter2_training_montage_7e9f744f:

    # narrator "Then a speech terminal throws insults at you through a blown speaker. Your job is not to answer. Your job is to make the silence feel like your decision."
    narrator "Después, una terminal de voz te lanza insultos por un altavoz averiado. Tu trabajo no es responder. Tu trabajo es hacer que el silencio parezca decisión tuya."

# game/chapter2.rpy:416
translate spanish chapter2_training_montage_84012729:

    # p "This place spent federal money teaching people how not to reply?"
    p "¿Este lugar gastó dinero federal en enseñar a la gente a no responder?"

# game/chapter2.rpy:418
translate spanish chapter2_training_montage_6dea0566:

    # c "Billions. Try to look grateful."
    c "Miles de millones. Intenta mostrar gratitud."

# game/chapter2.rpy:420
translate spanish chapter2_training_montage_069b10c4:

    # narrator "By the time the last restraint unlocks, your jaw aches in a muscle you didn't know existed. The sensor on your wrist keeps returning the same verdict: {color=#88ff88}AURA: RISING.{/color}"
    narrator "Cuando se abre la última sujeción, te duele la mandíbula en un músculo que no sabías que existía. El sensor de tu muñeca repite el mismo veredicto: {color=#88ff88}AURA: EN AUMENTO.{/color}"

# game/chapter2.rpy:424
translate spanish chapter2_kai_tutorial_71b19767:

    # narrator "At the center of the gym, a training bot waits on the mat. Its faceplate glows awake as you step into the ring."
    narrator "En el centro del gimnasio, un bot de entrenamiento espera sobre la colchoneta. La placa de su rostro se ilumina cuando entras al ring."

# game/chapter2.rpy:426
translate spanish chapter2_kai_tutorial_a9c9f3fb:

    # c "This is where all of it becomes pressure."
    c "Aquí es donde todo se convierte en presión."

# game/chapter2.rpy:427
translate spanish chapter2_kai_tutorial_d566b502:

    # c "Frame. Aura. Timing."
    c "Frame. Aura. Timing."

# game/chapter2.rpy:428
translate spanish chapter2_kai_tutorial_b1f019d8:

    # c "The system will show you the rest."
    c "El sistema te mostrará el resto."

# game/chapter2.rpy:431
translate spanish chapter2_kai_tutorial_8d2ebc7a:

    # narrator "A timing line switches on between you and the bot. It lowers into a ready stance."
    narrator "Una línea de timing se enciende entre el bot y tú. El bot adopta una postura de combate."

# game/chapter2.rpy:434
translate spanish chapter2_kai_tutorial_c0499bfb:

    # narrator "The bot stops. A clean green light scans across its faceplate."
    narrator "El bot se detiene. Una luz verde y nítida recorre su placa facial."

# game/chapter2.rpy:435
translate spanish chapter2_kai_tutorial_b82f6fdd:

    # narrator "It resets your Aura to {color=#69ff9a}100 / 100{/color}, then takes one step back."
    narrator "Restablece tu Aura a {color=#69ff9a}100 / 100{/color} y luego da un paso atrás."

# game/chapter2.rpy:440
translate spanish chapter2_kai_graduation_ae31190a:

    # c "Tutorial's over."
    c "Se acabó el tutorial."

# game/chapter2.rpy:441
translate spanish chapter2_kai_graduation_9db87c04:

    # c "Same bot."
    c "El mismo bot."

# game/chapter2.rpy:442
translate spanish chapter2_kai_graduation_22c01621:

    # c "No answer lights. No help."
    c "Sin luces con respuestas. Sin ayuda."

# game/chapter2.rpy:444
translate spanish chapter2_kai_graduation_ff3d384c:

    # narrator "The bot's guidance display goes dark. The room gets quiet enough to hear the mat under your shoes."
    narrator "La pantalla de guía del bot se apaga. La sala queda tan silenciosa que oyes la colchoneta bajo tus zapatos."

# game/chapter2.rpy:447
translate spanish chapter2_kai_graduation_c7f250a5:

    # narrator "It's close. It is not clean. But when it's over, you're the one still standing up straight with {color=#69ff9a}[kai_graduation_result['aura_kept']] AURA{/color}."
    narrator "Estuvo cerca. No fue limpio. Pero cuando termina, tú sigues de pie y con la espalda recta, conservando {color=#69ff9a}[kai_graduation_result['aura_kept']] DE AURA{/color}."

# game/chapter2.rpy:450
translate spanish chapter2_kai_graduation_456c552a:

    # c "Adequate."
    c "Aceptable."

# game/chapter2.rpy:452
translate spanish chapter2_kai_graduation_726cbcdb:

    # narrator "The bot powers down with a soft mechanical sigh. Across the gym, the lights start shutting off row by row."
    narrator "El bot se apaga con un suave suspiro mecánico. Al otro lado del gimnasio, las luces empiezan a apagarse fila por fila."

# game/chapter2.rpy:453
translate spanish chapter2_kai_graduation_41f9ce74:

    # narrator "Clav is already walking toward the exit."
    narrator "Clav ya va rumbo a la salida."

# game/chapter2.rpy:463
translate spanish chapter2_eugene_a92b823a:

    # narrator "On the way out, a mop squeaks in a side corridor. You almost keep walking. You don't."
    narrator "Al salir, un trapeador rechina en un pasillo lateral. Casi sigues caminando. Pero no."

# game/chapter2.rpy:465
translate spanish chapter2_eugene_4770286c:

    # narrator "Folded-in shoulders. Eyes down. A lanyard that just says INTERN. You know that exact posture — you wore it for years."
    narrator "Hombros encogidos. Mirada baja. Un gafete que solo dice BECARIO. Conoces perfectamente esa postura: la llevaste durante años."

# game/chapter2.rpy:466
translate spanish chapter2_eugene_3eb8b366:

    # p "...Eugene?"
    p "...¿Eugene?"

# game/chapter2.rpy:467
translate spanish chapter2_eugene_cf8cae21:

    # eu "Oh. Hey."
    eu "Ah. Hola."

# game/chapter2.rpy:468
translate spanish chapter2_eugene_6c8245fb:

    # p "What are you doing here?"
    p "¿Qué haces aquí?"

# game/chapter2.rpy:469
translate spanish chapter2_eugene_2c993e4b:

    # eu "Internship. Unpaid. But the wi-fi's honestly insane, so."
    eu "Pasantía. Sin paga. Pero, la verdad, el wi-fi está brutal, así que..."

# game/chapter2.rpy:470
translate spanish chapter2_eugene_047432e3:

    # narrator "He keeps mopping. He isn't waiting for you to stick around. Nobody ever does."
    narrator "Sigue trapeando. No espera que te quedes. Nadie lo espera nunca."

# game/chapter2.rpy:472
translate spanish chapter2_eugene_7e46dcc0:

    # narrator "Then you notice the angle: his eyes down, yours up. For once, the room has already decided which of you matters more."
    narrator "Entonces notas el ángulo: su mirada abajo, la tuya arriba. Por una vez, la sala ya decidió quién de los dos importa más."

# game/chapter2.rpy:473
translate spanish chapter2_eugene_a94afeec:

    # narrator "No voice tells you what to do. You can keep that advantage and make him feel it — or give it up before it turns you into someone familiar."
    narrator "Ninguna voz te dice qué hacer. Puedes conservar la ventaja y hacer que la sienta, o renunciar a ella antes de que te convierta en alguien que reconoces."

# game/chapter2.rpy:494
translate spanish chapter2_eugene_d4c26dca:

    # narrator "You don't insult him. You don't need to. You straighten, hold his eyes, and let the silence compare you."
    narrator "No lo insultas. No hace falta. Te enderezas, sostienes su mirada y dejas que el silencio los compare."

# game/chapter2.rpy:495
translate spanish chapter2_eugene_28af32e7:

    # narrator "The hallway changes sides. Eugene's joke dies first. Then his shoulders fold, as if your new frame has actual weight."
    narrator "El pasillo cambia de bando. La broma de Eugene muere primero. Luego se le encogen los hombros, como si tu nuevo frame tuviera un peso real."

# game/chapter2.rpy:496
translate spanish chapter2_eugene_369a8bf7:

    # eu "...yeah. 'Course."
    eu "...sí. Claro."

# game/chapter2.rpy:497
translate spanish chapter2_eugene_013a5221:

    # narrator "It lands exactly the way you wanted. That's the worst part. No Clav in your ear. No audience to impress. This one was yours."
    narrator "Impacta exactamente como querías. Esa es la peor parte. No hay un Clav hablándote al oído. No hay público que impresionar. Esto fue decisión tuya."

# game/chapter2.rpy:503
translate spanish chapter2_eugene_23dd8d70:

    # narrator "You give up the angle. You crouch down, so you're not looking at him from above."
    narrator "Renuncias al ángulo. Te agachas para no mirarlo desde arriba."

# game/chapter2.rpy:504
translate spanish chapter2_eugene_20d0df93:

    # p "For what it's worth — the wi-fi bit was actually funny. And nobody who grinds this quiet stays invisible forever. I'd know."
    p "Por si sirve de algo, lo del wi-fi sí fue gracioso. Y nadie que se esfuerce así de callado se queda invisible para siempre. Créeme."

# game/chapter2.rpy:506
translate spanish chapter2_eugene_83c4472b:

    # narrator "Eugene stops mopping. Looks at you properly — the first time anyone's really looked at him all day."
    narrator "Eugene deja de trapear. Te mira de verdad, la primera vez que alguien lo mira en todo el día."

# game/chapter2.rpy:507
translate spanish chapter2_eugene_67cb0b18:

    # eu "...huh. Most people who come through here don't even see me."
    eu "...ah. La mayoría de la gente que pasa por aquí ni siquiera me ve."

# game/chapter2.rpy:508
translate spanish chapter2_eugene_09c04a6c:

    # narrator "He stands a little straighter. You did that without an audience. Somehow, that feels more real than anything you proved today."
    narrator "Se endereza un poco. Lograste eso sin público. De algún modo, se siente más real que cualquier cosa que demostraste hoy."

# game/chapter2.rpy:525
translate spanish chapter2_return_a525274b:

    # narrator "Night. The desert unspools backward outside the window. You've been quiet a long time."
    narrator "Noche. El desierto se desenrolla al revés afuera de la ventana. Llevas mucho tiempo en silencio."

# game/chapter2.rpy:526
translate spanish chapter2_return_560b5b1d:

    # p "So what was that, actually? All of it."
    p "Entonces, ¿qué fue todo eso en realidad? Todo."

# game/chapter2.rpy:528
translate spanish chapter2_return_36ff671e:

    # c "Proof. None of this started on your phone."
    c "Una prueba. Nada de esto empezó en tu teléfono."

# game/chapter2.rpy:529
translate spanish chapter2_return_3c373003:

    # c "You walked in an LTN. You're walking out a problem."
    c "Entraste como LTN. Sales como un problema."

# game/chapter2.rpy:531
translate spanish chapter2_return_7d5e3441:

    # narrator "You catch your reflection in the side mirror and sit up without deciding to."
    narrator "Ves tu reflejo en el espejo lateral y te enderezas sin decidirlo."

